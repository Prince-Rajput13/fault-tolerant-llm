# ==============================================================================
# Fault-Tolerant LLM Gateway - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------

# Comma-separated pool of at least 2 LLM provider API keys.
# Assigned deterministic identifiers key_1, key_2, ... in order of appearance.
LLM_API_KEYS=your-primary-gemini-api-key,your-secondary-gemini-api-key

# LiteLLM model identifier (default: gemini/gemini-2.5-flash)
LLM_MODEL=gemini/gemini-2.5-flash

# SQLite connection URL. In Docker, this maps to the persistent /data named volume.
DATABASE_URL=sqlite:////data/app.db

# Comma-separated list of allowed CORS origins for browser clients.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# Failover testing hook switch (true enables evaluation of X-Simulate-Failure header).
ENABLE_FAILURE_SIMULATION=true

# Default baseline system instructions for newly initiated chat sessions.
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------

# Base URL pointing to the deployed or local backend API instance.
VITE_API_URL=http://localhost:8000
