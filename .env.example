# ==========================================
# Fault-Tolerant LLM Chatbot Environment Variables
# ==========================================

# Backend LLM Configuration
# Comma-separated API key pool (at least 2 keys; key_1, key_2, ... in order)
LLM_API_KEYS=your-primary-key,your-secondary-key

# LiteLLM model name (default: gemini/gemini-2.5-flash)
LLM_MODEL=gemini/gemini-2.5-flash

# SQLite Database URL (mounted volume /data/app.db in Docker)
DATABASE_URL=sqlite:////data/app.db

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable failover test hook (X-Simulate-Failure header support)
ENABLE_FAILURE_SIMULATION=true

# Default assistant system prompt
DEFAULT_SYSTEM_PROMPT=You are a helpful assistant.

# Frontend Configuration
# URL of the backend API
VITE_API_URL=http://localhost:8000
